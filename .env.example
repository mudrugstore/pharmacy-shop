# ===== Flask =====
# คีย์ลับสำหรับเข้ารหัส session (สุ่มค่ายาวๆ มาใส่ ห้ามเปิดเผย)
SECRET_KEY=change-this-to-a-long-random-string

# ===== Supabase: ฐานข้อมูล PostgreSQL =====
# เอามาจาก Supabase > Project Settings > Database > Connection string (URI)
# รูปแบบ: postgresql://postgres.xxxx:[PASSWORD]@aws-0-xxx.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ===== Supabase: Storage (เก็บรูปสินค้า) =====
# เอามาจาก Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ service_role key (ความลับสูง ใช้เฉพาะฝั่ง server เท่านั้น ห้ามเปิดเผย)
SUPABASE_SERVICE_KEY=your-service-role-key
# ชื่อ bucket ที่สร้างไว้ใน Supabase Storage สำหรับเก็บรูปสินค้า
SUPABASE_BUCKET=product-images

# ===== Admin =====
# เบอร์โทรของบัญชีแอดมิน (ระบบจะสร้าง/อัปเกรดบัญชีนี้เป็น admin อัตโนมัติตอนรันครั้งแรก)
ADMIN_PHONE=0800000000
# รหัสผ่านเริ่มต้นของแอดมิน (เปลี่ยนทีหลังได้)
ADMIN_PASSWORD=changeme123
ADMIN_NAME=ผู้ดูแลระบบ

# ===== ข้อมูลร้าน (แสดงในข้อความติดต่อ) =====
STORE_NAME=ร้านขายยาออนไลน์
STORE_PHONE=02-000-0000
